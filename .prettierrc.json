{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": [".vscode/*.json"],
      "options": { "parser": "jsonc", "trailingComma": "none" }
    }
  ]
}
